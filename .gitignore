# ---------------------------------------------------------------------------
# AutoRM training / evaluation artefacts
# ---------------------------------------------------------------------------
# Reward Model / SAC checkpoints (large binaries, regenerated by training).
checkpoints/
**/checkpoints/

# Per-run logs from train.sh / SAC training.
logs/
runs/

# Auto-generated evaluation outputs from eval_suite.py.
eval_results/

# Experiment output directories (kept in tree only via reports under exp_logs/).
exp_runs/

# Auto-generated dataset artefacts that the labelling pipeline rewrites.
data/**/*.pkl
data/**/*.npy
data/**/*.npz
data/mw_*/
data/**/auto_processed/*.pkl
data/**/manual_processed/*.pkl
data/**/*_lerobot.pkl
data/**/*_lerobot_format.pkl

# TensorBoard event files committed accidentally.
events.out.tfevents.*

# ---------------------------------------------------------------------------
# Local scratch / WIP notes (kept locally, not pushed)
# ---------------------------------------------------------------------------
m.txt
dev.txt
*.local.md
scratch/
tmp/
